{
  "name": "popover",
  "version": "10.0.0",
  "scripts": {
    "ng": "ng",
    "start": "nx serve popper-test",
    "build": "nx build",
    "lint": "nx run-many -t lint --projects=@muntazir/material-extended,popper-test",
    "e2e": "playwright install --with-deps chromium && nx e2e popper-test-e2e",
    "build:demo": "nx build popper-test --configuration production",
    "build:prod": "nx build @muntazir/material-extended --configuration production",
    "build:pack": "ng-packagr -p libs/@muntazir/material-extended/ng-package.json",
    "publish": "npm run build:prod && npm publish --access public ./dist/@muntazir/material-extended",
    "deploy": "nx run popper-test:deploy --base-href=/mde-popover/",
    "watch": "nx build --watch --configuration development",
    "test": "nx test @muntazir/material-extended --coverage",
    "test:demo": "nx test popper-test",
    "commitlint": "commitlint --from HEAD~1 --to HEAD"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.1.6",
    "@angular/cdk": "21.1.6",
    "@angular/common": "21.1.6",
    "@angular/compiler": "21.1.6",
    "@angular/core": "21.1.6",
    "@angular/forms": "21.1.6",
    "@angular/material": "21.1.6",
    "@angular/platform-browser": "21.1.6",
    "@angular/platform-browser-dynamic": "21.1.6",
    "@angular/router": "21.1.6",
    "angular-cli-ghpages": "^2.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "0.16.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.1.5",
    "@angular-devkit/core": "21.1.5",
    "@angular-devkit/schematics": "21.1.5",
    "@angular/build": "^21.1.5",
    "@angular/cli": "21.1.5",
    "@angular/compiler-cli": "21.1.6",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@nx/angular": "22.5.4",
    "@nx/eslint": "^22.5.4",
    "@nx/eslint-plugin": "^22.5.4",
    "@nx/js": "22.5.4",
    "@nx/playwright": "^22.5.4",
    "@nx/workspace": "22.5.4",
    "@playwright/test": "^1.64.1",
    "@schematics/angular": "21.1.5",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.2",
    "@swc/helpers": "0.5.23",
    "@types/jasmine": "~4.3.0",
    "@typescript-eslint/parser": "^8.71.2",
    "@typescript-eslint/utils": "^8.71.2",
    "@vitest/coverage-v8": "^4.0.8",
    "angular-eslint": "^21.4.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jasmine-core": "~4.6.0",
    "jsdom": "^27.0.1",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "ng-packagr": "21.1.0",
    "nx": "22.5.4",
    "postcss": "^8.4.5",
    "postcss-url": "~10.1.3",
    "prettier": "^2.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.0.8"
  }
}
