{
  "name": "popover",
  "version": "11.0.0",
  "license": "ISC",
  "scripts": {
    "ng": "ng",
    "start": "nx serve popper-test",
    "build": "nx build",
    "lint": "nx run-many -t lint --projects=@muntazir/material-extended,popper-test",
    "e2e": "playwright install --with-deps chromium && nx e2e popper-test-e2e",
    "build:demo": "nx build popper-test --configuration production",
    "build:prod": "nx build @muntazir/material-extended --configuration production",
    "build:pack": "ng-packagr -p libs/@muntazir/material-extended/ng-package.json -c libs/@muntazir/material-extended/tsconfig.lib.prod.json",
    "publish": "npm run build:prod && npm publish --access public ./dist/@muntazir/material-extended",
    "watch": "nx build --watch --configuration development",
    "test": "nx test @muntazir/material-extended --coverage",
    "test:demo": "nx test popper-test",
    "commitlint": "commitlint --from HEAD~1 --to HEAD"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "22.2.3",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/material": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-browser-dynamic": "22.2.3",
    "@angular/router": "22.2.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/core": "22.2.3",
    "@angular-devkit/schematics": "22.2.3",
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@nx/angular": "23.3.0",
    "@nx/eslint": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/playwright": "23.3.0",
    "@nx/workspace": "23.3.0",
    "@playwright/test": "^1.64.1",
    "@schematics/angular": "22.2.3",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.2",
    "@swc/helpers": "0.5.23",
    "@typescript-eslint/parser": "^8.71.2",
    "@typescript-eslint/utils": "^8.71.2",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "22.6.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^30.1.3",
    "ng-packagr": "22.2.4",
    "nx": "23.3.0",
    "postcss": "^8.4.5",
    "prettier": "^2.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "ajv": {
      "fast-uri": "3.1.9"
    },
    "vite": "8.3.5",
    "nx": {
      "undici": "^7.30.1"
    },
    "union": {
      "qs": "6.17.0"
    }
  }
}
