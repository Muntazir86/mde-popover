{
  "name": "@muntazir/material-extended",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/@muntazir/material-extended/src",
  "prefix": "mde",
  "tags": ["type:lib", "scope:popover"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/@muntazir/material-extended"],
      "options": {
        "project": "libs/@muntazir/material-extended/ng-package.json",
        "tsConfig": "libs/@muntazir/material-extended/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/@muntazir/material-extended/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "buildTarget": "@muntazir/material-extended:build:development",
        "tsConfig": "libs/@muntazir/material-extended/tsconfig.spec.json",
        "runner": "vitest",
        "watch": false,
        "coverage": true,
        "coverageReporters": ["text", "text-summary", "lcov", "html"],
        "coverageInclude": ["libs/@muntazir/material-extended/src/**/*.ts"],
        "coverageExclude": ["**/*.spec.ts"],
        "coverageThresholds": {
          "statements": 90,
          "branches": 90,
          "functions": 90,
          "lines": 90
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "{projectRoot}/**/*.ts",
          "{projectRoot}/**/*.html"
        ]
      }
    },
    "nx-release-publish": {
      "dependsOn": ["build"],
      "executor": "@nx/js:release-publish",
      "options": {
        "packageRoot": "dist/@muntazir/material-extended",
        "access": "public"
      }
    }
  }
}
