  "projectType": "application",
  "sourceRoot": "apps/popper-test-e2e/src",
  "implicitDependencies": ["popper-test", "@muntazir/material-extended"],
  "targets": {
    "e2e": {
      "executor": "@nx/playwright:playwright",
